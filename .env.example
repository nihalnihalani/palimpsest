# Direct Gemini SDK (for our own LLM calls)
GEMINI_API_KEY=

# Cognee LLM (LiteLLM under the hood)
LLM_PROVIDER=gemini
LLM_MODEL=gemini/gemini-3-pro
LLM_API_KEY=${GEMINI_API_KEY}
LLM_ENDPOINT=https://generativelanguage.googleapis.com/
LLM_API_VERSION=v1beta
LLM_INSTRUCTOR_MODE=json_mode

# Cognee embeddings — must also be set or Cognee 401s on OpenAI default
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=${GEMINI_API_KEY}
EMBEDDING_DIMENSIONS=768

# Cognee storage backends
#   Graph: Kuzu (embedded, default for this project)
#   Vectors: LanceDB (cognee default). The community Redis vector adapter
#   (cognee-community-vector-adapter-redis) exists as a separate package but is
#   intentionally NOT used here — cognee's built-in LanceDB is reliable and our
#   "Best Use of Redis" surface comes from Streams/JSON/Pub-Sub + RedisVL
#   SemanticCache + cognee session memory (REDIS_URL routes session_id=...
#   writes to Redis automatically).
GRAPH_DATABASE_PROVIDER=kuzu

# Redis — session memory + streams + json + pub/sub + RedisVL SemanticCache.
#   Local docker:  redis://localhost:6379
#   Local brew:    redis://localhost:6379    (brew install redis-stack-server)
#   Redis Cloud:   redis://default:<password>@<host>.cloud.redislabs.com:<port>
#                  (get this from your Redis Cloud database's "Connect" tab —
#                   needs RedisJSON + Search modules; the free Essentials plan
#                   includes them by default)
REDIS_URL=redis://localhost:6379

# Cognee 1.x defaults multi-user mode ON; disable for single-user hackathon
ENABLE_BACKEND_ACCESS_CONTROL=false

# Cognee 1.x session memory layer. When set, cognee.remember(..., session_id=X)
# routes through Redis as fast scratchpad before distilling to the graph.
CACHING=true

# ─── OPTIONAL: Cognee Cloud (managed instance) ───
# Leave both blank to run cognee fully local (the default — uses bundled
# LanceDB vectors + Kuzu graph). Set both to route ALL cognee operations
# (remember/recall/improve/forget/visualize) to a managed instance instead.
# Get an API key at https://platform.cognee.ai once you have a tenant.
#   COGNEE_SERVICE_URL=https://<your-tenant>.cognee.ai
#   COGNEE_API_KEY=ck_...
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
