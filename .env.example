# ============================================================================
# Palimpsest .env -- copy to .env and fill in keys, then `./run.sh setup`.
#
# Tested working configuration:
#   LLM        = OpenAI (cognee 1.1.0 + LiteLLM Gemini adapter has bugs we
#                couldn't sidestep; OpenAI works cleanly)
#   Embeddings = OpenAI text-embedding-3-small (1536 dims)
#   Graph + Vectors = Cognee Cloud (sidesteps local kuzu lock issues)
#   Session memory  = Redis Cloud or local Redis Stack
# ============================================================================

# ─── Optional direct Gemini SDK key ─────────────────────────────────────────
# Only needed when LLM_PROVIDER=gemini. OpenAI mode uses LLM_API_KEY below for
# the app's synthesis, contradiction checks, and eval grading.
GEMINI_API_KEY=

# ─── Cognee LLM (LiteLLM under the hood) ────────────────────────────────────
# Use OpenAI here. Gemini works in isolation but cognee 1.1.0's instructor
# adapter for Gemini returns empty 404s on structured output -- avoid.
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_ENDPOINT=https://api.openai.com/v1
LLM_API_VERSION=
LLM_INSTRUCTOR_MODE=tools

# ─── Cognee embeddings ──────────────────────────────────────────────────────
# OpenAI text-embedding-3-small (1536 dims, cheap). Larger option:
# text-embedding-3-large (3072 dims).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536

# ─── Cognee storage backends ────────────────────────────────────────────────
#   Graph: Kuzu (embedded, default for this project)
#   Vectors: LanceDB (cognee default). The community Redis vector adapter
#   (cognee-community-vector-adapter-redis) exists as a separate package but is
#   intentionally NOT used here -- our "Best Use of Redis" surface is
#   Streams/JSON/Pub-Sub + RedisVL SemanticCache + cognee session memory,
#   not the vector store.
GRAPH_DATABASE_PROVIDER=kuzu

# The CLI sets Cognee's local storage to repo-local absolute paths at runtime.
# If you run Cognee directly outside `wiki`, set these to absolute paths:
# SYSTEM_ROOT_DIRECTORY=/absolute/path/to/wiki-hackathon/.cognee_system
# DATA_ROOT_DIRECTORY=/absolute/path/to/wiki-hackathon/.data_storage
# CACHE_ROOT_DIRECTORY=/absolute/path/to/wiki-hackathon/.cognee_cache

# ─── Redis: session memory + streams + json + pub/sub + RedisVL SemanticCache ─
#   Local docker:  redis://localhost:6379
#   Local brew:    redis://localhost:6379    (brew install redis-stack-server)
#   Redis Cloud:   rediss://default:<password>@<host>.cloud.redislabs.com:<port>
#                  (get this from your Redis Cloud database's "Connect" tab --
#                   needs RedisJSON + Search modules; the free Essentials plan
#                   includes them by default. Use rediss:// for TLS.)
REDIS_URL=redis://localhost:6379

# Cognee 1.x defaults multi-user mode ON; disable for single-user hackathon
ENABLE_BACKEND_ACCESS_CONTROL=false

# Cognee 1.x session memory layer. When set, cognee.remember(..., session_id=X)
# routes through Redis as fast scratchpad before distilling to the graph.
CACHING=true

# Bypass cognee's 30s LLM connection probe at pipeline start. Our setup
# already verifies the LLM works; the probe sometimes hangs against external
# endpoints and the timeout aborts the whole pipeline.
COGNEE_SKIP_CONNECTION_TEST=true

# ─── OPTIONAL: Cognee Cloud (managed instance) ──────────────────────────────
# RECOMMENDED for this project: set both to route ALL cognee operations
# (remember/recall/improve/forget/visualize) to a managed instance. Local
# kuzu has multi-process lock contention if you ever run two wiki commands at
# once; cloud sidesteps that entirely.
# Sign up at https://platform.cognee.ai for a tenant URL + API key.
#   COGNEE_SERVICE_URL=https://<your-tenant>.cognee.ai
#   COGNEE_API_KEY=<token>
COGNEE_SERVICE_URL=
COGNEE_API_KEY=
